# Cloudflare Pages / Netlify — équivalent du bloc "headers" de vercel.json.
# Les fichiers d'/assets portent un hash dans leur nom : ils peuvent être mis
# en cache indéfiniment. Les polices ne changent qu'en cas de mise à jour
# explicite, même traitement.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
