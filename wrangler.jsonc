{
  // Site 100 % statique : aucun script Worker, on ne sert que le contenu de dist.
  // Sans ce fichier, `wrangler deploy` ne sait pas quoi publier et va inspecter
  // vite.config.js, d'où l'erreur "Error parsing file".
  "name": "portfolio-2026",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Une URL inconnue reçoit dist/404.html avec un vrai code 404.
    //
    // Auparavant "single-page-application" : toute URL morte répondait 200
    // avec le contenu de l'accueil, que Google compte comme une page
    // indexable de plus — un « soft 404 » par adresse erronée, toutes
    // dupliquant l'accueil.
    //
    // Le repli SPA était aussi le filet de sécurité des six routes, et n'était
    // retirable qu'une fois vérifié en ligne que Cloudflare résout bien
    // /prestations vers prestations/index.html. Vérifié le 21 octobre 2026 :
    // la page servait déjà son propre <title>, donc la résolution ne doit
    // rien au repli.
    "not_found_handling": "404-page"
  }
}
